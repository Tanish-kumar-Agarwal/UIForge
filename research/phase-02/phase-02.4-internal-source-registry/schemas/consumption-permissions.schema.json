{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UIForge Consumption Permissions Schema",
  "description": "Authoritative Draft-07 JSON Schema for UIForge 6-Mode Consumption Permissions",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "permissionId",
      "candidateId",
      "sourceId",
      "consumptionMode",
      "eligibility",
      "allowed",
      "conditions",
      "counselReviewRequired"
    ],
    "properties": {
      "permissionId": {
        "type": "string"
      },
      "candidateId": {
        "type": "string"
      },
      "sourceId": {
        "type": "string"
      },
      "consumptionMode": {
        "type": "string",
        "enum": [
          "REFERENCE_ONLY",
          "DEPENDENCY",
          "SOURCE_COPY",
          "ASSET_REDISTRIBUTION",
          "EXTERNAL_TOOL",
          "TEMPLATE_ADAPTATION"
        ]
      },
      "eligibility": {
        "type": "string",
        "enum": [
          "APPROVED",
          "ELIGIBLE_WITH_RESTRICTIONS",
          "REFERENCE_ONLY",
          "PENDING_REVIEW",
          "BLOCKED",
          "NOT_APPLICABLE"
        ]
      },
      "allowed": {
        "type": "boolean"
      },
      "conditions": {
        "type": "array",
        "items": { "type": "string" }
      },
      "referenceScope": {
        "type": "object",
        "properties": {
          "publicDocumentationInspection": { "type": "boolean" },
          "factualResearch": { "type": "boolean" },
          "publicSourceCodeInspection": { "type": "boolean" },
          "localCloning": { "type": "boolean" },
          "automatedScraping": { "type": "boolean" },
          "codeCopying": { "type": "boolean" }
        }
      },
      "requiredNotices": {
        "type": "array",
        "items": { "type": "string" }
      },
      "requiredAttribution": {
        "type": "array",
        "items": { "type": "string" }
      },
      "sourceAvailabilityRequirements": {
        "type": "array",
        "items": { "type": "string" }
      },
      "counselReviewRequired": {
        "type": "boolean"
      },
      "counselReviewRef": {
        "type": ["string", "null"]
      },
      "lastReviewedAt": {
        "type": "string"
      }
    }
  }
}
