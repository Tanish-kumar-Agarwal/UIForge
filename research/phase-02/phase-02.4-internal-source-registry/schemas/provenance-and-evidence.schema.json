{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UIForge Provenance and Evidence Schema",
  "description": "Authoritative Draft-07 JSON Schema for Provenance Records and Granular Evidence Dossiers",
  "definitions": {
    "provenanceRecord": {
      "type": "object",
      "required": [
        "provenanceId",
        "subjectType",
        "subjectId",
        "upstreamUrl",
        "retrievedAt",
        "contentDigest",
        "verificationMethod"
      ],
      "properties": {
        "provenanceId": { "type": "string" },
        "subjectType": { "type": "string" },
        "subjectId": { "type": "string" },
        "upstreamUrl": { "type": ["string", "null"] },
        "upstreamVersion": { "type": "string" },
        "upstreamCommit": { "type": "string" },
        "retrievedAt": { "type": "string" },
        "contentDigest": { "type": "string" },
        "verificationMethod": { "type": "string" },
        "provenanceIntegrityLevel": { "type": "string" },
        "digestAlgorithm": { "type": "string" },
        "canonicalizationMethod": { "type": "string" },
        "hashedContentDescription": { "type": "string" },
        "digestRecalculationStatus": { "type": "string" },
        "changeDetectionMethod": { "type": "string" },
        "reviewer": { "type": "string" }
      }
    },
    "evidenceItem": {
      "type": "object",
      "required": [
        "evidenceItemId",
        "claimType",
        "claimSupported",
        "exactSourceArtifact",
        "classification",
        "retrievalDate",
        "verificationClassification",
        "confidence"
      ],
      "properties": {
        "evidenceItemId": { "type": "string" },
        "claimType": { "type": "string" },
        "claimSupported": { "type": "string" },
        "exactSourceArtifact": { "type": ["string", "null"] },
        "evaluatedVersionOrCommit": { "type": "string" },
        "relevantFileOrSection": { "type": "string" },
        "retrievalDate": { "type": "string" },
        "classification": {
          "type": "string",
          "enum": [
            "UPSTREAM_SOURCE",
            "PACKAGE_REGISTRY",
            "RELEASE_MANIFEST",
            "LICENSE_FILE",
            "TEST_OUTPUT",
            "INDEPENDENT_AUDIT",
            "VENDOR_DOCUMENTATION"
          ]
        },
        "verificationClassification": {
          "type": "string",
          "enum": [
            "VERIFIED_FROM_SOURCE",
            "VERIFIED_FROM_PACKAGE_METADATA",
            "VERIFIED_BY_LOCAL_TEST",
            "MANUALLY_INSPECTED"
          ]
        },
        "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "limitations": { "type": "string" }
      }
    },
    "evidenceDossier": {
      "type": "object",
      "required": [
        "dossierId",
        "sourceId",
        "candidateId",
        "canonicalCandidateId",
        "dossierType",
        "compiledAt",
        "totalEvidenceItems",
        "evidenceItems"
      ],
      "properties": {
        "dossierId": { "type": "string" },
        "sourceId": { "type": "string" },
        "candidateId": { "type": "string" },
        "canonicalCandidateId": { "type": "string" },
        "dossierType": { "type": "string" },
        "compiledAt": { "type": "string" },
        "totalEvidenceItems": { "type": "integer", "minimum": 1 },
        "evidenceItems": {
          "type": "array",
          "items": { "$ref": "#/definitions/evidenceItem" }
        }
      }
    }
  },
  "type": "array",
  "items": {
    "anyOf": [
      { "$ref": "#/definitions/provenanceRecord" },
      { "$ref": "#/definitions/evidenceDossier" }
    ]
  }
}
