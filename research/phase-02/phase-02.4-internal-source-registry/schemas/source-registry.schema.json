{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UIForge Source Registry Schema",
  "description": "Authoritative Draft-07 JSON Schema for the UIForge Phase 02.4 Internal Source Registry Dataset",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "sourceId",
      "canonicalCandidateId",
      "name",
      "slug",
      "sourceType",
      "primaryCategory",
      "identityStatus",
      "originalDiscoveryPriority",
      "currentDiscoveryPriority",
      "registryOperationalTier",
      "discoveryPriority",
      "technicalEvaluationStatus",
      "licenseDisposition",
      "registryEligibility",
      "packageRefs",
      "licenseRef",
      "provenanceRef",
      "evaluationRef"
    ],
    "properties": {
      "sourceId": {
        "type": "string",
        "pattern": "^SRC-[A-Z0-9-]+$"
      },
      "canonicalCandidateId": {
        "type": "string",
        "pattern": "^[A-Z0-9-]+$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "sourceType": {
        "type": "string",
        "enum": [
          "OPEN_SOURCE_REPOSITORY",
          "COMPONENT_REGISTRY",
          "MONOREPO",
          "ABANDONED_PROJECT",
          "COMMERCIAL_PRODUCT",
          "SPECIFICATION",
          "PROPRIETARY_FREE_COMMERCIAL",
          "ICON_ASSET",
          "FONT_ASSET",
          "DOCUMENTATION_RESOURCE",
          "INFRASTRUCTURE_TOOL"
        ]
      },
      "description": {
        "type": "string"
      },
      "homepage": {
        "type": ["string", "null"]
      },
      "repositoryUrl": {
        "type": ["string", "null"]
      },
      "documentationUrl": {
        "type": ["string", "null"]
      },
      "externalPlatformUrl": {
        "type": ["string", "null"]
      },
      "primaryCategory": {
        "type": "string"
      },
      "secondaryCategories": {
        "type": "array",
        "items": { "type": "string" }
      },
      "aliases": {
        "type": "array",
        "items": { "type": "string" }
      },
      "identityStatus": {
        "type": "string",
        "enum": ["CANONICAL", "ALIASED", "DEPRECATED", "HISTORICAL"]
      },
      "originalDiscoveryPriority": {
        "type": "string",
        "enum": ["P0", "P1", "P2", "REJ"]
      },
      "currentDiscoveryPriority": {
        "type": "string",
        "enum": ["P0", "P1", "P2", "REJ"]
      },
      "registryOperationalTier": {
        "type": "string",
        "enum": ["TIER_A", "TIER_B", "TIER_C", "TIER_D"]
      },
      "discoveryPriority": {
        "type": "string",
        "enum": ["P0", "P1", "P2", "REJ"]
      },
      "technicalEvaluationStatus": {
        "type": "string",
        "enum": ["complete", "partial", "not_evaluated", "EVALUATED", "PARTIALLY_EVALUATED"]
      },
      "licenseDisposition": {
        "type": "string",
        "enum": [
          "eligible",
          "conditional",
          "blocked",
          "PERMISSIVE",
          "PERMISSIVE_WITH_NOTICE",
          "CONDITIONAL",
          "COPYLEFT_RESTRICTED",
          "PROPRIETARY_CLOSED",
          "BLOCKED"
        ]
      },
      "registryEligibility": {
        "type": "string",
        "enum": [
          "approved",
          "conditional",
          "blocked",
          "reference_only",
          "APPROVED",
          "ELIGIBLE_WITH_RESTRICTIONS",
          "REFERENCE_ONLY",
          "PENDING_REVIEW",
          "BLOCKED",
          "NOT_APPLICABLE"
        ]
      },
      "repositoryRef": {
        "type": ["string", "null"]
      },
      "packageRefs": {
        "type": "array",
        "items": { "type": "string" }
      },
      "componentRefs": {
        "type": "array",
        "items": { "type": "string" }
      },
      "assetRefs": {
        "type": "array",
        "items": { "type": "string" }
      },
      "licenseRef": {
        "type": "string"
      },
      "licenseScope": {
        "type": "object"
      },
      "provenanceRef": {
        "type": "string"
      },
      "evaluationRef": {
        "type": "string"
      },
      "createdAt": {
        "type": "string"
      },
      "updatedAt": {
        "type": "string"
      }
    }
  }
}
