{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UIForgeCandidateMasterInventory",
  "type": "object",
  "required": [
    "schemaVersion",
    "inventoryId",
    "sourcePhase",
    "candidateCount",
    "candidates"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "inventoryId": {
      "type": "string"
    },
    "sourcePhase": {
      "type": "string"
    },
    "candidateCount": {
      "type": "integer"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidateId",
          "originalCandidateId",
          "canonicalName",
          "category",
          "priority",
          "candidateType",
          "status",
          "consumptionModes",
          "sourceInventoryReference"
        ],
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "originalCandidateId": {
            "type": "string"
          },
          "canonicalName": {
            "type": "string"
          },
          "repositoryUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "canonicalUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "packageNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "REJ"
            ]
          },
          "candidateType": {
            "type": "string",
            "enum": [
              "OPEN_SOURCE_REPOSITORY",
              "MONOREPO",
              "NPM_PACKAGE",
              "COMPONENT_REGISTRY",
              "DESIGN_SYSTEM",
              "SPECIFICATION",
              "DOCUMENTATION_RESOURCE",
              "COMMERCIAL_PRODUCT",
              "FONT_ASSET",
              "ICON_ASSET",
              "INFRASTRUCTURE_TOOL",
              "REFERENCE_RESOURCE",
              "ABANDONED_PROJECT",
              "OTHER"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duplicateOf": {
            "type": [
              "string",
              "null"
            ]
          },
          "duplicateType": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DEPRECATED",
              "ARCHIVED",
              "REJECTED",
              "COMMERCIAL_CLOSED"
            ]
          },
          "consumptionModes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceInventoryReference": {
            "type": "string"
          },
          "discovery_priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "REJ"]
          },
          "technical_evaluation": {
            "type": "string",
            "enum": ["complete", "partial", "failed"]
          },
          "license_disposition": {
            "type": "string",
            "enum": ["eligible", "eligible_with_restrictions", "pending", "ineligible"]
          },
          "registry_eligibility": {
            "type": "string",
            "enum": ["approved", "conditional", "reference_only", "blocked"]
          }
        }
      }
    }
  }
}